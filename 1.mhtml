.viewer .inf .title a { color: rgb(143, 143, 143); }

.viewer .inf .title { font-size: 16px; margin-top: 60px; line-height: 20px;=
 font-weight: 300; }

.viewer .inf .data { margin-top: 5px; }

.viewer .sizes { margin-top: 20px; height: 30px; }

.viewer .li, .viewer .si, .viewer .vi { min-width: 100px; height: 30px; mar=
gin: 0px 8px 5px 0px; padding: 0px 5px; background-color: rgb(47, 47, 47); =
float: left; background-image: linear-gradient(rgb(47, 47, 47) 0px, rgb(38,=
 38, 38) 100%); border-radius: 2px; }

.viewer .sizes a { padding: 5px 0px; text-align: center; }

.viewer .xpl { position: absolute; bottom: 50px; }

.viewer .xpl h2 { font-size: 15px; color: rgb(102, 102, 102); }

.viewer .xpl ul { width: auto; margin-top: 8px; }

.viewer .xpl ul li { width: 100%; height: 50px; padding-top: 4px; }

.viewer .xpl ul li a { display: inline; float: left; width: 50px; height: 5=
0px; overflow: hidden; margin-right: 12px; }

.viewer .xpl ul li .query { width: auto; height: auto; }

.viewer .sizes a, .viewer .xpl ul li a { color: rgb(143, 143, 143); transit=
ion: color 0.2s ease-in; }

.viewer .sizes a:hover, .viewer .xpl ul li:hover a.query { color: rgb(241, =
241, 241); }

